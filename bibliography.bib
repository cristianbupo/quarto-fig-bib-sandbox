  issn = {1996-1944},
  doi = {10.3390/ma17030745},
  abstract = {The eXtended finite element method (XFEM) is a powerful tool for structural mechanics, assisting engineers and designers in understanding how a material  architecture responds to stresses and consequently assisting the creation of  mechanically improved structures. The XFEM method has unraveled the extraordinary  relationships between material topology and fracture behavior in biological and  engineered materials, enhancing peculiar fracture toughening mechanisms, such as  crack deflection and arrest. Despite its extensive use, a detailed revision of  case studies involving XFEM with a focus on the applications rather than the  method of numerical modeling is in great need. In this review, XFEM is introduced  and briefly compared to other computational fracture models such as the contour  integral method, virtual crack closing technique, cohesive zone model, and  phase-field model, highlighting the pros and cons of the methods (e.g., numerical  convergence, commercial software implementation, pre-set of crack parameters, and  calculation speed). The use of XFEM in material design is demonstrated and  discussed, focusing on presenting the current research on composites and  biological and bioinspired materials, but also briefly introducing its  application to other fields. This review concludes with a discussion of the XFEM  drawbacks and provides an overview of the future perspectives of this method in  applied material science research, such as the merging of XFEM and artificial  intelligence techniques.},
  langid = {english},
  pmcid = {PMC10856485},
  pmid = {38591618},
  keywords = {AI,bioinspiration,biological materials,composites,FEM,fracture modeling,XFEM},
  file = {/mnt/nvme0n1p4/Documents/ZoteroFiles/resources/vellwockXFEMCompositesBiological2024.pdf}
}

@article{wongTheoreticalModelEndochondral1990,
  title = {A Theoretical Model of Endochondral Ossification and Bone Architectural Construction in Long Bone Ontogeny.},
  author = {Wong, M. and Carter, D. R.},
  year = {1990},
  journal = {Anatomy and embryology},
  volume = {181},
  number = {6},
  pages = {523--532},
  address = {Germany},
  issn = {0340-2061},
  doi = {10.1007/BF00174625},
  abstract = {The role of mechanical stresses in the formation of endochondral ossification patterns and the construction of basic bone architecture in human long bones is  investigated using a three-dimensional generalized model of long bone  development. The distribution of mechanical stress which is created in developing  bones as a result of intermittent mechanical loading is calculated using a  computer model that mathematically represents the bone's geometry, material  properties and loading conditions. The process of endochondral ossification is  simulated by iteratively converting cartilaginous regions of the computer model  to bone, based on the calculated intermittent hydrostatic and shear stress  distributions. Once local regions of mineralized bone have formed, these regions  are remodeled according to an algorithm which relates bone density to a  mechanical stress stimulus. The results simulated the correct sequence of the  appearance of morphological structures which are common to long bones in the  human appendicular skeleton. These developmental structures include the site of  the first endochondral bone and the secondary ossification center and the tubular  nature of long bones. Our results suggest that mechanical loading histories may  influence bone morphogenesis beginning from the early stages of endochondral  ossification and continuing throughout life. The stress-based algorithms may be  part of the 'rules of construction' or 'developmental constraints' which guide  limb ontogeny.},
  langid = {english},
  pmid = {2396753},
  keywords = {*Models,*Models Theoretical,Algorithms,Bone and Bones/cytology/*physiology,Bone Development/*physiology,Humans,Osteogenesis/*physiology,Theoretical},
  file = {/home/app/references/wongTheoreticalModelEndochondral1990 - Place Germany.md;/home/app/references/wongTheoreticalModelEndochondral1990-zotero.md;/home/app/references/wongTheoreticalModelEndochondral1990.md;/mnt/nvme0n1p4/Documents/myNotes/Ossification/references/wongTheoreticalModelEndochondral1990 - Place Germany.md;/mnt/nvme0n1p4/Documents/myNotes/Ossification/references/wongTheoreticalModelEndochondral1990-zotero.md;/mnt/nvme0n1p4/Documents/myNotes/Ossification/references/wongTheoreticalModelEndochondral1990.md;/mnt/nvme0n1p4/Documents/ZoteroFiles/resources/wongTheoreticalModelEndochondral1990.pdf}
}

@article{xieSecondaryOssificationCenter2020,
  title = {Secondary Ossification Center Induces and Protects Growth Plate Structure},
  author = {Xie, Meng and Gol'din, Pavel and Herdina, Anna Nele and Estefa, Jordi and Medvedeva, Ekaterina V and Li, Lei and Newton, Phillip T and Kotova, Svetlana and Shavkuta, Boris and Saxena, Aditya and Shumate, Lauren T and Metscher, Brian D and Gro{\ss}schmidt, Karl and Nishimori, Shigeki and Akovantseva, Anastasia and Usanova, Anna P and Kurenkova, Anastasiia D and Kumar, Anoop and Arregui, Irene Linares and Tafforeau, Paul and Fried, Kaj and Carlstr{\"o}m, Mattias and Simon, Andr{\'a}s and Gasser, Christian and Kronenberg, Henry M and Bastepe, Murat and Cooper, Kimberly L and Timashev, Peter and Sanchez, Sophie and Adameyko, Igor and Eriksson, Anders and Chagin, Andrei S},
  editor = {Rosen, Clifford J and Cao, Xu and Vortkamp, Andrea},
  year = {2020},
  month = oct,
  journal = {eLife},
  volume = {9},
  pages = {e55212},
  publisher = {eLife Sciences Publications, Ltd},
  issn = {2050-084X},
  doi = {10.7554/eLife.55212},
  abstract = {Growth plate and articular cartilage constitute a single anatomical entity early in development but later separate into two distinct structures by the secondary ossification center (SOC). The reason for such separation remains unknown. We found that evolutionarily SOC appears in animals conquering the land - amniotes. Analysis of the ossification pattern in mammals with specialized extremities (whales, bats, jerboa) revealed that SOC development correlates with the extent of mechanical loads. Mathematical modeling revealed that SOC reduces mechanical stress within the growth plate. Functional experiments revealed the high vulnerability of hypertrophic chondrocytes to mechanical stress and showed that SOC protects these cells from apoptosis caused by extensive loading. Atomic force microscopy showed that hypertrophic chondrocytes are the least mechanically stiff cells within the growth plate. Altogether, these findings suggest that SOC has evolved to protect the hypertrophic chondrocytes from the high mechanical stress encountered in the terrestrial environment.},
  article_type = {journal},
  citation = {eLife 2020;9:e55212},
  pub_date = {2020-10-16},
  keywords = {bat,chondrocytes,growth plate,jerboa,secondary ossification,whale},
  file = {/mnt/nvme0n1p4/Documents/myNotes/Ossification/references/xieSecondaryOssificationCenter2020-zotero.md;/mnt/nvme0n1p4/Documents/ZoteroFiles/resources/xieSecondaryOssificationCenter2020.pdf}
}
