@article{kronenbergDevelopmentalRegulationGrowth2003,
  title = {Developmental Regulation of the Growth Plate.},
  author = {Kronenberg, Henry M.},
  year = {2003},
  month = may,
  journal = {Nature},
  volume = {423},
  number = {6937},
  pages = {332--336},
  address = {England},
  issn = {0028-0836},
  doi = {10.1038/nature01657},
  abstract = {Vertebrates do not look like jellyfish because the bones of their skeletons are levers that allow movement and protect vital organs. Bones come in an enormous  variety of shapes and sizes to accomplish these goals, but, with few exceptions,  use one process--endochondral bone formation--to generate the skeleton. The past  few years have seen an enormous increase in understanding of the signalling  pathways and the transcription factors that control endochondral bone  development.},
  langid = {english},
  pmid = {12748651},
  keywords = {*Signal Transduction/drug effects,Animals,Bone Development/drug effects,Bone Morphogenetic Proteins/pharmacology,Fibroblast Growth Factors/pharmacology,Growth Plate/drug effects/*embryology/growth & development/*metabolism,Hedgehog Proteins,Trans-Activators/metabolism,Transcription Factors/*metabolism},
  file = {/home/app/references/kronenbergDevelopmentalRegulationGrowth2003-zotero.md;/home/app/references/kronenbergDevelopmentalRegulationGrowth2003.md;/mnt/nvme0n1p4/Documents/myNotes/Ossification/references/kronenbergDevelopmentalRegulationGrowth2003-zotero.md;/mnt/nvme0n1p4/Documents/myNotes/Ossification/references/kronenbergDevelopmentalRegulationGrowth2003-zotero.md;/mnt/nvme0n1p4/Documents/myNotes/Ossification/references/kronenbergDevelopmentalRegulationGrowth2003.md;/mnt/nvme0n1p4/Documents/ZoteroFiles/resources/kronenbergDevelopmentalRegulationGrowth2003.pdf}
