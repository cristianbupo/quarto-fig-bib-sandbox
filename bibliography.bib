@article{garzon-alvaradoReactiondiffusionModelLong2009,
  title = {A Reaction-Diffusion Model for Long Bones Growth.},
  author = {{Garz{\'o}n-Alvarado}, D. A. and {Garc{\'i}a-Aznar}, J. M. and Doblar{\'e}, M.},
  year = {2009},
  month = oct,
  journal = {Biomechanics and modeling in mechanobiology},
  volume = {8},
  number = {5},
  pages = {381--395},
  address = {Germany},
  issn = {1617-7940},
  doi = {10.1007/s10237-008-0144-z},
  abstract = {Bone development is characterized by differentiation and growth of chondrocytes from the proliferation zone to the hypertrophying one. These two cellular  processes are controlled by a complex signalling regulatory loop between  different biochemical signals, whose production depends on the current cell  density, constituting a coupled cell-chemical system. In this work, a  mathematical model of the process of early bone growth is presented, extending  and generalizing other earlier approaches on the same topic. A reaction-diffusion  regulatory loop between two chemical factors: parathyroid hormone-related peptide  (PTHrP) and Indian hedgehog (Ihh) is hypothesized, where PTHrP is activated by  Ihh and inhibits Ihh production. Chondrocytes proliferation and hypertrophy are  described by means of population equations being both regulated by the PTHrP and  Ihh concentrations. In the initial stage of bone growth, these two cellular  proceses are considered to be directionally dependent, modelling the well known  column cell formation, characteristic of endochondral ossification. This coupled  set of equations is solved within a finite element framework, getting an  estimation of the chondrocytes spatial distribution, growth of the diaphysis and  formation of the epiphysis of a long bone. The results obtained are qualitatively  similar to the actual physiological ones and quantitatively close to some  available experimental data. Finally, this extended approach allows finding  important relations between the model parameters to get stability of the  physiological process and getting additional insight on the spatial and  directional distribution of cells and paracrine factors.},
  langid = {english},
  pmid = {19107533},
  keywords = {*Diffusion,*Models,*Models Biological,Animals,Biological,Bone Development/*physiology,Cell Differentiation,Cell Proliferation,Chondrocytes/pathology,Elasticity,Femur/cytology/embryology,Hedgehog Proteins/metabolism,Humans,Hypertrophy,Mice,Parathyroid Hormone-Related Protein/metabolism},
  file = {/home/app/references/garzon-alvaradoReactiondiffusionModelLong2009 - ContentsA reaction--diffusion model for long bones growthAbstract1 Introduction2 Materials and methods2.1 Model descript.md;/home/app/references/garzon-alvaradoReactiondiffusionModelLong2009 - Place Germany.md;/home/app/references/garzon-alvaradoReactiondiffusionModelLong2009-zotero.md;/home/app/references/garzon-alvaradoReactiondiffusionModelLong2009.md;/mnt/nvme0n1p4/Documents/myNotes/Ossification/references/garzon-alvaradoReactiondiffusionModelLong2009 - ContentsA reaction--diffusion model for long bones growthAbstract1 Introduction2 Materials and methods2.1 Model descript.md;/mnt/nvme0n1p4/Documents/myNotes/Ossification/references/garzon-alvaradoReactiondiffusionModelLong2009 - ContentsA reaction--diffusion model for long bones growthAbstract1 Introduction2 Materials and methods2.1 Model descript.md;/mnt/nvme0n1p4/Documents/myNotes/Ossification/references/garzon-alvaradoReactiondiffusionModelLong2009 - Place Germany.md;/mnt/nvme0n1p4/Documents/myNotes/Ossification/references/garzon-alvaradoReactiondiffusionModelLong2009 - Place Germany.md;/mnt/nvme0n1p4/Documents/myNotes/Ossification/references/garzon-alvaradoReactiondiffusionModelLong2009-zotero.md;/mnt/nvme0n1p4/Documents/myNotes/Ossification/references/garzon-alvaradoReactiondiffusionModelLong2009-zotero.md;/mnt/nvme0n1p4/Documents/myNotes/Ossification/references/garzon-alvaradoReactiondiffusionModelLong2009.md;/mnt/nvme0n1p4/Documents/ZoteroFiles/resources/garzon-alvaradoReactiondiffusionModelLong2009.pdf}
